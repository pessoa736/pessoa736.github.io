---
// Davi's cut-out portrait on a piece of deep space, seen through an old tube TV:
// the tube-TV texture itself is applied to the whole screen in global.css.
// The image file is clean (background removed by `npm run foto`); every effect is CSS,
// so changing the photo never means redoing the filter.
interface Props { src?: string; alt?: string }
const { src = "/images/eu-recorte.webp", alt = "Foto do Davi" } = Astro.props;
---
<figure class="tv">
  <div class="sun" aria-hidden="true"></div>
  <img src={src} alt={alt} width="900" height="1000" loading="eager" decoding="async" />
</figure>

<style>
  .tv {
    position: absolute; inset: 0; isolation: isolate; overflow: hidden; margin: 0;
    background: radial-gradient(120% 90% at 50% 40%, #183533 0%, var(--void) 70%);
  }

  /* surreal touch: the sun from the orrery rises behind the head */
  .sun {
    position: absolute; z-index: 0;
    height: 58%; aspect-ratio: 1; left: 50%; top: 9%; translate: -20% 0;
    border-radius: 50%; background: var(--signal); opacity: 0.9;
  }

  .tv img {
    position: relative; z-index: 1;
    display: block; width: 100%; height: 100%;
    object-fit: contain; object-position: 50% 100%;
    padding-top: 6%;
    /* old print / tube look: monochrome, warm, a bit of contrast.
       (No drop-shadow here: on a large image it makes Chromium skip painting it.) */
    filter: grayscale(1) sepia(0.45) contrast(1.15) brightness(1.02);
  }

</style>
