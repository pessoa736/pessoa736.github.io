---
// Page frame used by every page: <head>, top navigation, footer.
import "../styles/global.css";

interface Props {
  title?: string;        // page title; the site name is appended
  description?: string;
}

const { title, description = "Davi, estudante de Ciência e Tecnologia na UFRN. Projetos em Lua, Rust e redes." } = Astro.props;
const fullTitle = title ? `${title} | davi` : "davi | garoto de programa";

const nav = [
  { href: "/", label: "início" },
  { href: "/projetos", label: "projetos" },
  { href: "/escritos", label: "escritos" },
  { href: "/sobre", label: "sobre" },
];
// "projetos" stays marked on /projetos/<repo>, and so on.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <header class="topbar wrap">
      <a class="brand" href="/" aria-label="davi, página inicial">davi<span>.</span></a>
      <nav aria-label="Principal">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="conteudo" class="wrap">
      <slot />
    </main>

    <footer class="footer wrap">
      <p class="links">
        <a href="https://github.com/pessoa736">GitHub</a>
        <a href="mailto:pessoa736@users.noreply.github.com">e-mail</a>
        <a href="/privacidade">privacidade</a>
      </p>
      <p class="muted">Feito com <a href="https://astro.build">Astro</a>. Código em <a href="https://github.com/pessoa736/pessoa736.github.io">pessoa736.github.io</a>.</p>
    </footer>
  </body>
</html>

<style>
  .topbar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .brand { font: 600 var(--step-1)/1 var(--font-mono); text-decoration: none; }
  .brand span { color: var(--accent); }
  nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; list-style: none; padding: 0; }
  nav a { display: inline-block; padding-block: 0.4rem; text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--text); }
  nav a[aria-current="page"] { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.45em; }

  .footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem;
    padding-block: 2rem 3rem; border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }
  .footer .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
</style>
