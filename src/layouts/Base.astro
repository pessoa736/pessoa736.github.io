---
// Page frame used by every page: <head>, top navigation, footer.
import "../styles/global.css";

interface Props {
  title?: string;        // page title; the site name is appended
  description?: string;
}

const { title, description = "Davi, estudante de Ciência e Tecnologia na UFRN. Projetos em Lua, Rust e redes." } = Astro.props;
const fullTitle = title ? `${title} | davi` : "davi | garoto de programa";

const nav = [
  { href: "/", label: "início" },
  { href: "/projetos", label: "projetos" },
  { href: "/escritos", label: "escritos" },
  { href: "/galeria", label: "galeria" },
  { href: "/sobre", label: "sobre" },
];
// "projetos" stays marked on /projetos/<repo>, and so on.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <header class="wrap"><div class="topbar">
      <a class="brand" href="/" aria-label="davi, página inicial">davi<span>.</span></a>
      <nav aria-label="Principal">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div></header>

    <main id="conteudo" class="wrap">
      <slot />
    </main>

    <footer class="wrap"><div class="footer">
      <p class="links">
        <a href="https://github.com/pessoa736">GitHub</a>
        <a href="mailto:pessoa736@users.noreply.github.com">e-mail</a>
        <a href="/privacidade">privacidade</a>
      </p>
      <p class="muted">Feito com <a href="https://astro.build">Astro</a>. Código em <a href="https://github.com/pessoa736/pessoa736.github.io">pessoa736.github.io</a>.</p>
    </div></footer>
  </body>
</html>

<style>
  /* brutalist frame: the nav is a ruled box, each link its own cell */
  .topbar {
    display: flex; align-items: stretch; justify-content: space-between; flex-wrap: wrap;
    margin-top: var(--gutter);
    border: var(--frame) solid var(--line);
  }
  .brand { display: flex; align-items: center; padding: 0.7rem 1.1rem; font: 700 var(--step-1)/1 var(--font-text); text-decoration: none; }
  .brand span { color: var(--accent); }
  nav ul { display: flex; flex-wrap: wrap; list-style: none; padding: 0; height: 100%; }
  nav li { display: flex; border-left: var(--frame) solid var(--line); }
  nav a { display: flex; align-items: center; padding: 0.7rem 1.2rem; min-height: 2.75rem; text-decoration: none; font-weight: 500; }
  nav a:hover { background: var(--surface); color: var(--text); }
  nav a[aria-current="page"] { background: var(--text); color: var(--bg); }
  @media (max-width: 560px) {
    .topbar { flex-direction: column; }
    nav { border-top: var(--frame) solid var(--line); }
    nav ul { display: grid; grid-template-columns: repeat(5, auto); }
    nav li:first-child { border-left: 0; }
    nav a { flex: 1; justify-content: center; padding-inline: 0.4rem; }
  }

  .footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem;
    padding-block: 1.25rem 3rem; border-top: var(--frame) solid var(--line); margin-top: 1rem;
    font-size: var(--step--1);
  }
  .footer .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
</style>
