---
import Base from "../layouts/Base.astro";
---
<Base title="página não encontrada">
  <div class="nf">
    <p class="code jitter">404</p>
    <h1>Não existe nada neste endereço</h1>
    <p>Talvez o link esteja antigo. Os caminhos mais prováveis:</p>
    <ul>
      <li><a href="/projetos">projetos</a></li>
      <li><a href="/escritos">escritos</a></li>
      <li><a href="/">página inicial</a></li>
    </ul>
  </div>
</Base>

<style>
  .nf { padding-block: 2rem; }
  .code { font: 600 var(--step-4)/1 var(--font-mono); color: var(--accent); }
  h1 { margin-top: 1rem; font-size: var(--step-2); }
  p { margin-top: 1rem; }
  ul { margin-top: 0.75rem; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
</style>
