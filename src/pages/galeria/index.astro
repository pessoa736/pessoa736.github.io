---
// /galeria: the albums (each opens at /galeria/<slug>) and the loose pictures.
import Base from "../../layouts/Base.astro";
import Wall from "../../components/Wall.astro";
import { loadGallery } from "../../lib/galeria";
const { albums, loose } = await loadGallery();
---
<Base title="galeria" description="Desenhos e fotos do Davi, organizados em álbuns.">
  <header class="page-head">
    <h1>Galeria</h1>
    <p class="muted">Desenhos e fotos.</p>
  </header>

  {albums.length === 0 && loose.length === 0 && (
    <p class="empty">Ainda não tem nada aqui. Enquanto isso, os <a href="/projetos">projetos</a> mostram o que ando construindo.</p>
  )}

  {albums.length > 0 && (
    <section class="section" aria-labelledby="albuns">
      <h2 id="albuns">Álbuns</h2>
      <ul class="albums">
        {albums.map((a) => (
          <li>
            <a href={`/galeria/${a.slug}`}>
              <span class="cover"><img src={a.cover.thumb.src} alt="" loading="lazy" decoding="async" /></span>
              <span class="name">{a.title}</span>
              <span class="meta muted">{a.pictures.length} {a.pictures.length === 1 ? "imagem" : "imagens"}</span>
              {a.description && <span class="about">{a.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {loose.length > 0 && (
    <section class="section" aria-labelledby="avulsas">
      {albums.length > 0 && <h2 id="avulsas">Avulsas</h2>}
      <Wall pictures={loose} />
    </section>
  )}
</Base>

<style>
  .page-head p { margin-top: 0.75rem; font-size: var(--step-1); }
  .empty { margin-top: 3rem; padding: 1.5rem; border: var(--frame) dashed var(--line); }

  /* albums as a ruled grid, same language as /projetos */
  .albums {
    list-style: none; padding: 0; margin-top: 1.25rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    border-top: var(--frame) solid var(--line); border-left: var(--frame) solid var(--line);
  }
  .albums li { max-width: none; border-right: var(--frame) solid var(--line); border-bottom: var(--frame) solid var(--line); }
  .albums a { display: flex; flex-direction: column; gap: 0.3rem; height: 100%; padding: 0.9rem; color: inherit; text-decoration: none; }
  .albums a:hover { background: var(--surface); }
  .albums a:hover .name { text-decoration: underline; text-decoration-color: var(--accent); }
  .cover { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--void); border: var(--frame) solid var(--line); margin-bottom: 0.4rem; }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .name { font-weight: 600; font-size: var(--step-1); }
  .meta { font-size: var(--step--1); }
  .about { font-size: var(--step--1); }
</style>
