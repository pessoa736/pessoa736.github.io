---
// /galeria: two views of the same gallery.
//   todas (default)  every picture on its own, last posted first, each with a link to its album
//   álbuns           the top-level albums (each opens at /galeria/<slug>) and the loose pictures
// The choice is a switch kept in the address (?ver=albuns). Without JavaScript both views
// are shown, one after the other.
import Base from "../../layouts/Base.astro";
import Wall from "../../components/Wall.astro";
import AlbumGrid from "../../components/AlbumGrid.astro";
import { loadGallery } from "../../lib/galeria";
const { albums, loose, feed } = await loadGallery();
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---
<Base title="galeria" description="Desenhos e fotos do Davi, do mais recente ao mais antigo, e organizados em álbuns.">
  <header class="page-head">
    <h1>Galeria</h1>
    <p class="muted">Desenhos e fotos.</p>
  </header>

  {feed.length === 0 ? (
    <p class="empty">Ainda não tem nada aqui. Enquanto isso, os <a href="/projetos">projetos</a> mostram o que ando construindo.</p>
  ) : (
    <>
      {albums.length > 0 && (
        <div class="views" role="group" aria-label="Como ver a galeria" hidden>
          <button type="button" data-view="" aria-pressed="true">todas as imagens <span>{feed.length}</span></button>
          <button type="button" data-view="albuns" aria-pressed="false">álbuns <span>{albums.length}</span></button>
        </div>
      )}

      <section class="panel" data-panel="" aria-labelledby="t-todas">
        <h2 id="t-todas" class="panel-title">Todas as imagens</h2>
        <p class="muted note">{plural(feed.length, "imagem", "imagens")}. A ordem e os filtros ficam em "filtros e ordem".</p>
        <div><Wall pictures={feed} showAlbum rows filterBar /></div>
      </section>

      {albums.length > 0 && (
        <section class="panel" data-panel="albuns" aria-labelledby="t-albuns">
          <h2 id="t-albuns" class="panel-title">Álbuns</h2>
          <AlbumGrid albums={albums} />
          {loose.length > 0 && (
            <div class="loose">
              <h2>Avulsas</h2>
              <p class="muted note">{plural(loose.length, "imagem fora de álbum", "imagens fora de álbum")}.</p>
              <div><Wall pictures={loose} /></div>
            </div>
          )}
        </section>
      )}
    </>
  )}
</Base>

<script>
  // switch between the views; same pattern as the filters on /projetos (state in the URL)
  const group = document.querySelector<HTMLElement>(".views");
  if (group) {
    group.hidden = false;
    const panels = [...document.querySelectorAll<HTMLElement>(".panel")];
    const apply = (view: string) => {
      if (!panels.some((p) => p.dataset.panel === view)) view = "";
      for (const p of panels) p.hidden = p.dataset.panel !== view;
      for (const b of group.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.view === view));
      document.body.classList.add("views-on");
      const url = new URL(location.href);
      view ? url.searchParams.set("ver", view) : url.searchParams.delete("ver");
      history.replaceState(null, "", url);
    };
    group.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (b) apply(b.dataset.view ?? "");
    });
    apply(new URL(location.href).searchParams.get("ver") ?? "");
  }
</script>

<style>
  .page-head p { margin-top: 0.75rem; font-size: var(--step-1); }
  .empty { margin-top: 3rem; padding: 1.5rem; border: var(--frame) dashed var(--line); }

  /* the switch: two ruled cells, the active one filled */
  .views { display: inline-flex; margin-top: 2rem; border: var(--frame) solid var(--line); }
  .views[hidden] { display: none; }
  .views button {
    font: inherit; font-size: var(--step--1); min-height: 2.75rem; padding: 0.4rem 1.1rem;
    color: var(--text); background: transparent; border: 0; cursor: pointer;
  }
  .views button + button { border-left: var(--frame) solid var(--line); }
  .views button span { font-family: var(--font-mono); color: var(--muted); margin-left: 0.35rem; }
  .views button[aria-pressed="true"] { background: var(--text); color: var(--bg); }
  .views button[aria-pressed="true"] span { color: inherit; }

  .panel { margin-top: 2rem; }
  .panel[hidden] { display: none; }
  .note { margin-top: 0.4rem; font-size: var(--step--1); }
  .loose { margin-top: 3rem; }
  /* with the switch working, its labels already name the view: hide the repeated titles */
  :global(body.views-on) .panel-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
