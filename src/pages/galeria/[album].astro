---
// /galeria/<slug>: one album. The slug is the folder name in src/assets/galeria/.
import Base from "../../layouts/Base.astro";
import Wall from "../../components/Wall.astro";
import { getEntry, render } from "astro:content";
import { albumSlugs, loadGallery } from "../../lib/galeria";

export async function getStaticPaths() {
  return (await albumSlugs()).map((album) => ({ params: { album } }));
}
const { albums } = await loadGallery();
const album = albums.find((a) => a.slug === Astro.params.album)!;
const note = await getEntry("albuns", album.slug);
const { Content } = note ? await render(note) : { Content: undefined };
---
<Base title={`${album.title}: galeria`} description={album.description ?? `Álbum ${album.title}, ${album.pictures.length} imagens.`}>
  <p class="back"><a href="/galeria">Galeria</a></p>
  <header class="page-head">
    <h1>{album.title}</h1>
    {album.description && <p class="lede">{album.description}</p>}
    <p class="muted meta">
      {album.pictures.length} {album.pictures.length === 1 ? "imagem" : "imagens"}
      {album.date && <> · <time datetime={album.date.toISOString()}>{album.date.toLocaleDateString("pt-BR", { month: "long", year: "numeric" })}</time></>}
    </p>
  </header>

  {Content && <div class="prose"><Content /></div>}

  <Wall pictures={album.pictures} />
</Base>

<style>
  .back { margin-top: 1.5rem; font-size: var(--step--1); }
  .back a::before { content: "← "; }
  .page-head { margin-top: 1rem; }
  .lede { margin-top: 0.75rem; font-size: var(--step-1); }
  .meta { margin-top: 0.5rem; font-size: var(--step--1); }
  .prose { margin-top: 1.5rem; max-width: 70ch; }
</style>
