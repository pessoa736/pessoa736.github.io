---
// Privacy policy for the Google Cloud app used by Hermes (Davi's personal assistant).
// Google links to this page from the OAuth consent screen: keep the URL (/privacidade)
// and keep the text accurate whenever the scopes change.
import Base from "../layouts/Base.astro";

/** Date of the last change to this text. Update it when the content changes. */
const ATUALIZADO_EM = "26 de novembro de 2026";

/** Permissions the app asks for on the Google account, with the matching OAuth scope. */
const PERMISSOES: [string, string, string][] = [
  ["gmail.readonly", "ler e-mails", "identificar prazos, avisos da universidade e oportunidades de bolsa e estágio. o app não envia, não apaga e não altera mensagens."],
  ["calendar.readonly", "ler a agenda", "saber o que já está marcado antes de sugerir horários."],
  ["calendar.events", "criar e editar eventos", "agendar prazos, provas e compromissos que eu peço."],
];
---
<Base title="privacidade" description="Política de privacidade do Hermes, o assistente pessoal que uso para organizar rotina, prazos e agenda.">
  <article class="policy">
    <header>
      <p class="muted kicker">hermes</p>
      <h1>Política de privacidade</h1>
      <p>
        <strong>Hermes</strong> é um assistente pessoal de uso privado, que roda no meu próprio computador
        e me ajuda a organizar rotina, prazos e estudos. O aplicativo registrado no Google Cloud existe
        só para que esse assistente acesse a minha conta Google. Ele não é oferecido ao público: o único
        usuário sou eu, o dono da conta.
      </p>
      <p class="muted small">Última atualização: {ATUALIZADO_EM}</p>
    </header>

    <section>
      <h2>Dados acessados</h2>
      <ul class="scopes">
        {PERMISSOES.map(([escopo, titulo, motivo]) => (
          <li>
            <strong>{titulo}</strong> <code class="muted">{escopo}</code>
            <p>{motivo}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Uso e armazenamento</h2>
      <ul>
        <li>Os dados servem apenas para organizar a minha própria rotina: prazos, provas, compromissos e estudos.</li>
        <li>As credenciais de acesso ficam guardadas somente no meu computador, em arquivos de acesso restrito. Nenhum servidor meu recebe cópia.</li>
        <li>Para gerar as respostas do assistente, trechos de e-mails e eventos podem ser processados pelo provedor do modelo de linguagem que eu contrato, segundo os termos desse provedor.</li>
        <li>Os dados não são vendidos, não alimentam publicidade, não treinam modelos e não são compartilhados com terceiros.</li>
      </ul>
    </section>

    <section>
      <h2>Uso limitado</h2>
      <p>
        O uso e a transferência de informações recebidas das APIs do Google seguem a
        <a href="https://developers.google.com/terms/api-services-user-data-policy">Política de dados do usuário dos serviços de API do Google</a>,
        incluindo os requisitos de uso limitado.
      </p>
    </section>

    <section>
      <h2>Como revogar o acesso</h2>
      <p>
        O acesso pode ser revogado a qualquer momento em
        <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>.
        Revogado o acesso, o assistente deixa de ler a conta na hora.
      </p>
    </section>

    <section>
      <h2>Contato</h2>
      <ul>
        <li><a href="mailto:pessoa736@users.noreply.github.com">pessoa736@users.noreply.github.com</a></li>
        <li><a href="https://github.com/pessoa736">github.com/pessoa736</a></li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .policy { max-width: var(--measure); }
  .kicker { font-family: var(--font-mono); font-size: var(--step--1); }
  header p { margin-top: 1rem; }
  .small { font-size: var(--step--1); }
  section { margin-top: 2.75rem; }
  h2 { font-size: var(--step-1); margin-bottom: 0.9rem; }
  ul { padding-left: 1.2rem; display: grid; gap: 0.6rem; }
  .scopes { list-style: none; padding: 0; gap: 1rem; }
  .scopes li { padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); max-width: none; }
  .scopes p { margin-top: 0.4rem; }
</style>
