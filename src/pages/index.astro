---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
import { getRepoStats } from "../lib/github";
import { getCollection } from "astro:content";

const stats = await getRepoStats();
const featured = projects.filter((p) => p.featured);
const posts = (await getCollection("escritos", ({ data }) => !(import.meta.env.PROD && data.draft)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="hero-text">
      <h1>davi<span class="dot">.</span></h1>
      <p class="tagline">garoto de programa</p>
      <p class="intro">
        Estudo Ciência e Tecnologia na UFRN e gosto de entender como as coisas funcionam por dentro:
        kernels, linguagens, redes. Programo principalmente em Lua e Rust.
      </p>
      <p class="intro">
        Estou procurando <strong>bolsa ou estágio</strong>. <a href="/sobre">Veja o que eu sei fazer</a>.
      </p>
    </div>
    <img class="photo" src="/images/jpg/eu.jpg" alt="Foto do Davi" width="240" height="240" />
  </section>

  <section class="section" aria-labelledby="destaques">
    <header>
      <h2 id="destaques">Em destaque</h2>
      <p>Os projetos em que estou mais envolvido agora.</p>
    </header>
    <ul class="list">
      {featured.map((p) => <ProjectRow project={p} stats={stats[p.repo]} />)}
    </ul>
    <p class="more"><a href="/projetos">Ver todos os {projects.length} projetos</a></p>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="escritos">
      <header>
        <h2 id="escritos">Escritos recentes</h2>
      </header>
      <ul class="list posts">
        {posts.map((post) => (
          <li>
            <a href={`/escritos/${post.id}`}>{post.data.title}</a>
            <time class="muted" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("pt-BR", { day: "numeric", month: "short", year: "numeric" })}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr auto; gap: 2rem 3rem; align-items: end; padding-top: 1.5rem; }
  h1 { font: 600 var(--step-4)/0.95 var(--font-mono); letter-spacing: -0.03em; }
  .dot { color: var(--accent); }
  .tagline { font: var(--step-1)/1.3 var(--font-mono); color: var(--muted); margin-top: 0.6rem; }
  .intro { font-size: var(--step-1); line-height: 1.5; margin-top: 1.4rem; max-width: 36ch; }
  .intro + .intro { margin-top: 0.8rem; }
  .photo { width: 240px; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .list { list-style: none; padding: 0; border-bottom: 1px solid var(--line); }
  .more { margin-top: 1.25rem; }
  .posts li { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.8rem; border-top: 1px solid var(--line); max-width: none; }
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; }
    .photo { width: 140px; order: -1; }
  }
</style>
