---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
import { getRepoStats } from "../lib/github";
import { getCollection } from "astro:content";

const stats = await getRepoStats();
const featured = projects.filter((p) => p.featured);
const posts = (await getCollection("escritos", ({ data }) => !(import.meta.env.PROD && data.draft)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// ── the orrery ───────────────────────────────────────────────
// A sun cut by the corner of the plate, with orbits around it. Each featured
// project is a planet on its own orbit (inner orbit = first featured project).
// Coordinates are in the SVG's 1200 x 720 space.
const SUN = { x: -60, y: 780, r: 300 };
const ORBITS = [420, 540, 660, 790, 930, 1080];
const ANGLES = [72, 36, 22, 9];               // degrees, where each planet sits on its orbit
const planets = featured.slice(0, ANGLES.length).map((project, i) => {
  const r = ORBITS[i];
  const a = (ANGLES[i] * Math.PI) / 180;
  return { project, x: SUN.x + r * Math.cos(a), y: SUN.y - r * Math.sin(a), size: [22, 30, 18, 26][i], ringed: i === 1 };
});
const built = new Date().toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric" }).replaceAll("/", ".");
---
<Base>
  <section class="plate" aria-labelledby="titulo">
    <svg class="orrery" viewBox="0 0 1200 720" role="img" aria-label="Um sol laranja no canto, com órbitas; cada planeta é um projeto em destaque.">
      <circle cx={SUN.x} cy={SUN.y} r={SUN.r} class="sun" />
      {ORBITS.map((r, i) => <circle cx={SUN.x} cy={SUN.y} r={r} class={i === 3 ? "orbit dotted" : "orbit"} />)}
      {planets.map((p) => (
        <a href={`/projetos/${p.project.repo}`} class="planet">
          <title>{p.project.title}</title>
          {p.ringed && <ellipse cx={p.x} cy={p.y} rx={p.size * 1.9} ry={p.size * 0.45} transform={`rotate(-24 ${p.x} ${p.y})`} class="ring" />}
          <circle cx={p.x} cy={p.y} r={p.size} />
          <text x={p.x + p.size + 16} y={p.y + 7} class="label">{p.project.title}</text>
        </a>
      ))}
    </svg>

    <div class="title">
      <h1 id="titulo">davi<span class="dot">.</span></h1>
      <p class="tagline">garoto de programa</p>
    </div>

    <!-- HUD corners: real information only -->
    <p class="hud tl">{built}</p>
    <p class="hud tr">procurando bolsa ou estágio</p>
    <p class="hud bl">natal, rn</p>
    <p class="hud br">{projects.length} projetos</p>
  </section>

  <section class="intro-grid">
    <figure class="photo">
      <img src="/images/jpg/eu.jpg" alt="Foto do Davi" width="400" height="400" />
    </figure>
    <div class="intro">
      <p>
        Estudo Ciência e Tecnologia na UFRN e gosto de entender como as coisas funcionam por dentro:
        kernels, linguagens, redes. Programo principalmente em Lua e Rust.
      </p>
      <p>
        Estou procurando <strong>bolsa ou estágio</strong>. <a href="/sobre">Veja o que eu sei fazer</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="destaques">
    <header>
      <h2 id="destaques">Em destaque</h2>
      <p>Os planetas lá em cima: os projetos em que estou mais envolvido agora.</p>
    </header>
    <ul class="list">
      {featured.map((p) => <ProjectRow project={p} stats={stats[p.repo]} />)}
    </ul>
    <p class="more"><a href="/projetos">Ver todos os {projects.length} projetos</a></p>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="escritos">
      <header><h2 id="escritos">Escritos recentes</h2></header>
      <ul class="list posts">
        {posts.map((post) => (
          <li>
            <a href={`/escritos/${post.id}`}>{post.data.title}</a>
            <time class="muted" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("pt-BR", { day: "numeric", month: "short", year: "numeric" })}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  /* the plate: a framed piece of deep space, like the poster references */
  .plate {
    position: relative;
    margin-top: -2rem;
    background: var(--void);
    color: var(--paper);
    border: var(--frame) solid var(--line);
    overflow: hidden;
  }
  .orrery { display: block; width: 100%; height: auto; }
  .sun { fill: var(--signal); }
  .orbit { fill: none; stroke: var(--paper); stroke-width: 1.5; opacity: 0.85; }
  .dotted { stroke-dasharray: 2 9; stroke-linecap: round; stroke-width: 2.5; }
  .planet circle { fill: var(--paper); }
  .ring { fill: none; stroke: var(--signal); stroke-width: 5; }
  .label { fill: var(--paper); font: 500 26px var(--font-text); }
  .planet:hover circle, .planet:focus-visible circle { fill: var(--signal); }
  .planet:hover .label { fill: var(--signal); }
  .planet:focus-visible { outline: none; }
  .planet:focus-visible .label { text-decoration: underline; }

  .title { position: absolute; top: 12%; right: 5%; text-align: right; }
  h1 { font: 700 var(--step-4)/0.85 var(--font-text); letter-spacing: -0.04em; }
  .dot { color: var(--signal); }
  .tagline { margin-top: 0.6rem; font-size: var(--step-1); letter-spacing: 0.02em; color: #cbbd99; }

  .hud { position: absolute; margin: 0; padding: 0.35rem 0.6rem; font: 0.8rem/1 var(--font-mono); color: #cbbd99; border: 1px solid #cbbd99; background: var(--void); }
  .tl { top: 0.8rem; left: 0.8rem; }
  .tr { top: 0.8rem; right: 0.8rem; display: none; }
  .bl { bottom: 0.8rem; left: 0.8rem; }
  .br { bottom: 0.8rem; right: 0.8rem; }

  /* photo + intro in ruled cells */
  .intro-grid {
    display: grid; grid-template-columns: minmax(10rem, 18rem) 1fr;
    border: var(--frame) solid var(--line); border-top: 0;
  }
  .photo { border-right: var(--frame) solid var(--line); background: var(--void); }
  .photo img { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; filter: grayscale(1) sepia(0.35) contrast(1.1); }
  .intro { padding: clamp(1.25rem, 3vw, 2.5rem); align-self: center; }
  .intro p { font-size: var(--step-1); line-height: 1.5; }
  .intro p + p { margin-top: 1rem; }

  .list { list-style: none; padding: 0; border-bottom: var(--frame) solid var(--line); }
  .more { margin-top: 1.25rem; }
  .posts li { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.8rem; border-top: var(--frame) solid var(--line); max-width: none; }

  @media (min-width: 900px) { .tr { display: block; } }
  @media (max-width: 720px) {
    .label { display: none; }               /* too small to read; the list below names them */
    .title { position: static; padding: 1.25rem 1rem 1rem; text-align: left; border-top: var(--frame) solid var(--paper); }
    .hud.bl, .hud.br { display: none; }
    .intro-grid { grid-template-columns: 1fr; }
    .photo { border-right: 0; border-bottom: var(--frame) solid var(--line); max-height: 16rem; overflow: hidden; }
  }
</style>
