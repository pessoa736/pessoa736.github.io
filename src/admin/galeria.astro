---
// /admin/galeria: albums, sub-albums and pictures. Dev server only (integrations/admin.mjs);
// everything happens through the local /__admin/galeria/* API, nothing is committed for you.
import AdminShell from "./AdminShell.astro";
---
<AdminShell title="galeria" section="galeria">
  <nav class="subtabs" aria-label="Galeria">
    <a href="/admin/galeria" aria-current="page">publicados</a>
    <a href="/admin/galeria/imagens">imagens (editar dados)</a>
    <a href="/admin/galeria/entrada">entrada (ainda não enviados)</a>
    <span class="note" id="waiting"></span>
  </nav>

  <section aria-label="Publicados">
    <div class="cols">
      <div class="side">
        <ul id="albums" class="pick-list"></ul>
        <button type="button" id="new-album">+ novo álbum</button>
        <p class="muted-note">Arraste imagens para um álbum da lista para movê-las. Arraste um álbum para dentro de outro para virar sub-álbum (ou para "avulsas" para voltar ao topo).</p>
      </div>
      <div id="editor"><p class="muted">Escolha um álbum.</p></div>
    </div>
    <pre id="log" hidden></pre>
  </section>
</AdminShell>

<script>
  // Safe innerHTML: every value interpolated below goes through esc() (or
  // encodeURIComponent inside thumb()), see src/admin/client.ts.
  import { $, dateField, dateLabel, draftBox, esc, fileDrop, get, hashValue, post, restoreStatus, say, setHash, slugify, uploadFiles } from "./client";

  type Meta = { title?: string; description?: string; kind?: string; date?: string; alt?: string; pinned?: string; draft?: boolean };
  type Pic = { key: string; file: string; meta: Meta; original: string; taken: string };
  type Album = { slug: string | null; pictures: Pic[]; data: Record<string, any>; body: string };
  type Wait = { album: string | null; files: string[]; fresh: number };

  let data: { albums: Album[]; waiting: Wait[] } = { albums: [], waiting: [] };
  // selected album: null = loose pictures, undefined = none. Kept in the address (#slug).
  let current: string | null | undefined = hashValue() === "avulsas" ? null : hashValue() || undefined;
  const selected = new Set<string>();   // picture keys ticked in the current album
  let lastTicked: string | undefined;   // for shift-click ranges

  const select = (slug: string | null) => {
    if (slug !== current) { selected.clear(); lastTicked = undefined; }
    current = slug;
    setHash(slug === null ? "avulsas" : slug);
  };
  const thumb = (path: string) => `/__admin/galeria/thumb?path=${encodeURIComponent(path)}`;
  const idOf = (file: string) => file.replace(/\.webp$/, "");
  const nameOf = (slug: string) => slug.split("/").at(-1)!;
  const parentOf = (slug: string) => (slug.includes("/") ? slug.slice(0, slug.lastIndexOf("/")) : "");
  const depth = (slug: string | null) => (slug ? slug.split("/").length : 0);
  const albumPaths = () => data.albums.filter((a) => a.slug).map((a) => a.slug!);
  const within = (slug: string, root: string) => slug === root || slug.startsWith(root + "/");
  const total = (slug: string) => data.albums.filter((a) => a.slug && within(a.slug, slug)).reduce((n, a) => n + a.pictures.length, 0);
  // a draft album hides itself and everything below it on the site
  const hiddenOnSite = (slug: string) => data.albums.some((a) => a.slug && a.data.draft && within(slug, a.slug));
  const label = (a: Album) => a.data.title || (a.slug ? nameOf(a.slug) : "(avulsas)");
  // "viagens / 2024" for selects, so nesting reads at a glance
  const pathLabel = (slug: string) => slug.split("/").join(" / ");

  async function load() {
    data = await get("galeria/state");
    for (const k of [...selected]) if (!data.albums.some((a) => a.pictures.some((p) => p.key === k))) selected.delete(k);
    // the open album may be gone (deleted or moved elsewhere): fall back to the nearest one above
    const exists = (s: string | null) => data.albums.some((a) => a.slug === s);
    while (typeof current === "string" && !exists(current)) select(parentOf(current) || null);
    renderWaiting();
    renderAlbums();
    if (current !== undefined && exists(current)) renderEditor();
    else $("#editor").innerHTML = '<p class="muted">Escolha um álbum.</p>';
  }

  // ── what is waiting in galeria-entrada/ (organised on /admin/galeria/entrada) ──
  function renderWaiting() {
    const n = data.waiting.reduce((s, w) => s + w.fresh, 0);
    $("#waiting").textContent = n ? `${n} imagem(ns) nova(s) esperando em ${data.waiting.filter((w) => w.fresh).length} pasta(s)` : "nada novo esperando";
  }

  // ── album tree ──
  function renderAlbums() {
    $("#albums").innerHTML = data.albums.map((a) => {
      const own = a.pictures.length, all = a.slug ? total(a.slug) : own;
      const counts = a.slug && all > own ? `${own} aqui · ${all} no total` : `${own}`;
      return `
      <li><button type="button" data-album="${esc(a.slug ?? "")}" aria-current="${a.slug === current}"
          ${a.slug ? 'draggable="true"' : ""} style="--depth:${Math.max(0, depth(a.slug) - 1)}">
        <span>${depth(a.slug) > 1 ? '<span class="depth-mark">└</span>' : ""}${esc(label(a))}</span>
        <span class="muted">${esc(a.slug ?? "sem álbum")} · ${counts}${a.data.draft ? " · rascunho" : ""}${a.slug && !all ? " · vazio" : ""}</span>
      </button></li>`;
    }).join("");
  }
  $("#albums").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-album]");
    if (!b) return;
    select(b.dataset.album || null);
    renderAlbums(); renderEditor();
  });

  // drag & drop: pictures onto an album (move them), an album onto another (nest it)
  const PICS = "application/x-galeria-pics", ALBUM = "application/x-galeria-album";
  $("#albums").addEventListener("dragstart", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-album]");
    if (!b?.dataset.album) return;
    e.dataTransfer!.setData(ALBUM, b.dataset.album);
    e.dataTransfer!.effectAllowed = "move";
  });
  $("#albums").addEventListener("dragover", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-album]");
    const types = e.dataTransfer?.types ?? [];
    if (!b || !(types.includes(PICS) || types.includes(ALBUM))) return;
    e.preventDefault();
    e.dataTransfer!.dropEffect = "move";
    for (const x of document.querySelectorAll(".drop-target")) if (x !== b) x.classList.remove("drop-target");
    b.classList.add("drop-target");
  });
  $("#albums").addEventListener("dragleave", (e) => {
    (e.target as HTMLElement).closest("[data-album]")?.classList.remove("drop-target");
  });
  $("#albums").addEventListener("drop", async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-album]");
    if (!b) return;
    e.preventDefault();
    b.classList.remove("drop-target");
    const to = b.dataset.album ?? "";
    try {
      const pics = e.dataTransfer!.getData(PICS);
      if (pics) return await movePictures(JSON.parse(pics), to);
      const from = e.dataTransfer!.getData(ALBUM);
      if (from) await moveAlbum(from, to ? `${to}/${nameOf(from)}` : nameOf(from));
    } catch (err: any) { say(err.message, true); }
  });

  async function movePictures(keys: string[], to: string) {
    const out = await post("galeria/pictures/move", { keys, to });
    keys.forEach((k) => selected.delete(k));
    say(`${out.moved} imagem(ns) movida(s) para ${to || "avulsas"}`);
    await load();
  }
  async function moveAlbum(from: string, to: string) {
    if (from === to) return;
    if (within(to, from)) throw new Error("um álbum não pode ir para dentro dele mesmo");
    if (!confirm(`Mover "${from}" para "${to}"? O endereço muda para /galeria/${to} (e o dos sub-álbuns também).`)) return;
    await post("galeria/album/move", { from, to });
    if (current && within(current, from)) select(to + current.slice(from.length));
    say("álbum movido"); await load();
  }
  async function createAlbum(parent: string) {
    const raw = prompt(parent ? `Nome do sub-álbum dentro de "${parent}" (vira o endereço):` : "Nome do álbum (vira o endereço /galeria/…):");
    if (!raw) return;
    const out = await post("galeria/album/create", { parent, name: slugify(raw) });
    select(out.slug);
    say(`álbum ${out.slug} criado: mova imagens para ele (vazio, ele não aparece no site)`);
    await load();
  }
  $("#new-album").addEventListener("click", () => createAlbum("").catch((err) => say(err.message, true)));

  // ── editor of the selected album ──
  function renderEditor() {
    const a = data.albums.find((x) => x.slug === current);
    if (!a) return;
    const slug = a.slug, d = a.data;
    const others = albumPaths().filter((s) => s !== slug);
    const children = slug ? albumPaths().filter((s) => parentOf(s) === slug) : [];
    // where this album may go: the top level or any album that isn't itself or below it
    const parents = slug ? albumPaths().filter((s) => !within(s, slug)) : [];
    const coverId = slug ? (d.cover ?? (a.pictures[0] ? idOf(a.pictures[0].file) : "")) : "";

    $("#editor").innerHTML = `
      ${slug ? `
      <form class="card" id="album-form">
        <h3>Álbum <span class="muted">/galeria/${esc(slug)}</span>${total(slug) && !hiddenOnSite(slug) ? ` <a href="/galeria/${esc(slug)}" target="_blank">ver ↗</a>` : ""}</h3>
        <div class="row">
          <label>nome (fim do endereço)<input name="name" value="${esc(nameOf(slug))}" pattern="[a-z0-9]+(-[a-z0-9]+)*"></label>
          <label>dentro de<select name="parent">
            <option value="">(topo da galeria)</option>
            ${parents.map((s) => `<option value="${esc(s)}" ${s === parentOf(slug) ? "selected" : ""}>${esc(pathLabel(s))}</option>`).join("")}
          </select></label>
          <button type="button" id="move-album">renomear / mover</button>
        </div>
        <label>título<input name="title" value="${esc(d.title)}" placeholder="${esc(nameOf(slug))}"></label>
        <label>descrição<input name="description" value="${esc(d.description)}"></label>
        <div class="row">
          ${dateField("date", d.date)}
          <label class="check"><input type="checkbox" name="draft" ${d.draft ? "checked" : ""}> rascunho (escondido do site, com os sub-álbuns)</label>
        </div>
        <label>texto (Markdown)<textarea name="body" rows="4">${esc(a.body)}</textarea></label>
        <input type="hidden" name="cover" value="${esc(d.cover)}">
        <div class="row">
          <button type="submit" class="primary">salvar álbum</button>
          <button type="button" id="new-sub">+ sub-álbum</button>
          <button type="button" class="danger push" id="delete-album">apagar álbum</button>
        </div>
        ${children.length ? `<p class="muted-note">Sub-álbuns: ${children.map((c) =>
          `<button type="button" data-goto="${esc(c)}">${esc(nameOf(c))}</button>`).join(" ")}</p>` : ""}
      </form>` : `
      <div class="card"><p class="muted">Imagens avulsas (sem álbum): aparecem soltas em /galeria.</p></div>`}

      <div class="dropzone" id="drop">
        <span>Adicionar imagens ${slug ? "a este álbum" : "avulsas"}: solte arquivos do computador aqui, ou</span>
        <label class="pickfile">escolher arquivos<input type="file" id="pick" multiple accept=".jpg,.jpeg,.png,.webp,.avif,.tif,.tiff"></label>
        <span class="muted-note">o original fica em galeria-entrada/, o site recebe a cópia leve</span>
        <label class="check"><input type="checkbox" id="up-drawing" ${slug && /desenho/.test(slug) ? "checked" : ""}> são desenhos</label>
        <label class="check"><input type="checkbox" id="up-draft" checked ${slug && /desenho/.test(slug) ? "" : "disabled"}> entram como rascunho</label>
      </div>

      ${a.pictures.length ? `
      <div class="selbar" role="toolbar" aria-label="Imagens selecionadas">
        <span class="count" id="sel-count"></span>
        <button type="button" data-sel="all">todas</button>
        <button type="button" data-sel="none">nenhuma</button>
        <select id="dest" aria-label="mover para">
          ${slug !== null ? '<option value="">(avulsas)</option>' : ""}
          ${others.map((s) => `<option value="${esc(s)}">${esc(pathLabel(s))}</option>`).join("")}
        </select>
        <button type="button" data-sel="move">mover</button>
        <button type="button" class="danger" data-sel="delete">tirar do site</button>
      </div>` : `<p class="muted-note" style="margin-top:1rem">Nenhuma imagem neste álbum${children.length ? " (só sub-álbuns)" : ""}. Selecione imagens em outro álbum e use "mover", ou arraste-as para cá na lista.</p>`}

      <ul class="pics">${a.pictures.map((p) => {
        const isCover = !!slug && coverId === idOf(p.file);
        return `
        <li class="pic ${isCover ? "is-cover" : ""} ${selected.has(p.key) ? "selected" : ""}" data-key="${esc(p.key)}" draggable="true">
          <label class="sel" title="selecionar"><input type="checkbox" data-tick ${selected.has(p.key) ? "checked" : ""} aria-label="selecionar ${esc(p.file)}"></label>
          ${isCover ? '<span class="badge">capa</span>' : ""}
          ${p.meta.pinned ? '<span class="badge pinned-badge">fixada</span>' : ""}
          ${p.meta.draft === true ? '<span class="badge draft-badge">rascunho</span>' : ""}
          <img loading="lazy" alt="" src="${thumb(p.key)}" draggable="false">
          <details>
            <summary>${esc(p.meta.title || p.file)}</summary>
            <form data-key="${esc(p.key)}">
              <label>nome do arquivo<input name="rename" value="${esc(idOf(p.file))}" pattern="[a-z0-9]+(-[a-z0-9]+)*" title="letras minúsculas, números e hífens"></label>
              <label>título<input name="title" value="${esc(p.meta.title)}"></label>
              <label>descrição<textarea name="description" rows="2">${esc(p.meta.description)}</textarea></label>
              <div class="row">
                <label>tipo<select name="kind">
                  <option value="foto" ${p.meta.kind !== "desenho" ? "selected" : ""}>foto</option>
                  <option value="desenho" ${p.meta.kind === "desenho" ? "selected" : ""}>desenho</option>
                </select></label>
                ${draftBox(p.meta)}
                ${dateField("date", p.meta.date, !p.meta.date && p.taken ? `vazio: o site usa ${dateLabel(p.taken)}, do nome do arquivo` : "")}
              </div>
              <label>texto alternativo<input name="alt" value="${esc(p.meta.alt)}" placeholder="o que aparece na imagem"></label>
              <div class="row">
                <button type="submit">salvar</button>
                <button type="button" data-pin="${p.meta.pinned ? "0" : "1"}">${p.meta.pinned ? "desafixar" : "fixar no topo"}</button>
                ${slug ? `<button type="button" data-cover="${esc(idOf(p.file))}" ${isCover ? "disabled" : ""}>${isCover ? "é a capa" : "usar como capa"}</button>` : ""}
              </div>
            </form>
          </details>
        </li>`;
      }).join("")}</ul>`;
    // "entram como rascunho" only makes sense for drawings
    $("#up-drawing")?.addEventListener("change", (e) => {
      const box = document.querySelector<HTMLInputElement>("#up-draft")!;
      box.disabled = !(e.target as HTMLInputElement).checked;
      if (!box.disabled) box.checked = true;
    });
    fileDrop($("#drop"), (files) => addPictures(files, slug ?? "").catch((err) => say(err.message, true)));
    $<HTMLInputElement>("#pick").addEventListener("change", (e) =>
      addPictures([...((e.target as HTMLInputElement).files ?? [])], slug ?? "").catch((err) => say(err.message, true)));
    updateSelection();
  }

  // upload to the inbox folder of this album, then publish exactly those files
  async function addPictures(files: File[], album: string) {
    const up = await uploadFiles(files, { album });
    if (!up.paths.length) { say(up.skipped.length ? `formato não aceito: ${up.skipped.join(", ")}` : "nada enviado", true); return; }
    say(`publicando ${up.paths.length} imagem(ns)…`);
    const out = await post("galeria/entrada/publish", { paths: up.paths });
    const log = $("#log"); log.hidden = false; log.textContent = out.log;
    const added = Number(out.log.match(/(\d+) adicionada/)?.[1] ?? 0);
    // drawings: type "desenho" and, unless unticked, "rascunho" on what was just added
    const newKeys = [...String(out.log).matchAll(/→ (\S+\.webp)/g)].map((m) => m[1]);
    if (newKeys.length && document.querySelector<HTMLInputElement>("#up-drawing")?.checked)
      await post("galeria/pictures/save", { keys: newKeys, patch: { kind: "desenho", draft: !!document.querySelector<HTMLInputElement>("#up-draft")?.checked } });
    say(`${added} adicionada(s) ao álbum${up.paths.length - added ? `, ${up.paths.length - added} já estava(m) na galeria` : ""}${up.skipped.length ? ` · formato não aceito: ${up.skipped.join(", ")}` : ""}`);
    await load();
  }

  function updateSelection() {
    const count = document.getElementById("sel-count");
    if (!count) return;
    count.textContent = `${selected.size} selecionada(s)`;
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-sel="move"], [data-sel="delete"]')) b.disabled = selected.size === 0;
    for (const li of document.querySelectorAll<HTMLElement>(".pic")) {
      const on = selected.has(li.dataset.key!);
      li.classList.toggle("selected", on);
      li.querySelector<HTMLInputElement>("[data-tick]")!.checked = on;
    }
  }
  const currentKeys = () => data.albums.find((x) => x.slug === current)?.pictures.map((p) => p.key) ?? [];
  // tick one picture; with shift, everything between the last ticked and this one
  function tick(key: string, on: boolean, range: boolean) {
    const keys = currentKeys();
    if (range && lastTicked && keys.includes(lastTicked)) {
      const [i, j] = [keys.indexOf(lastTicked), keys.indexOf(key)].sort((x, y) => x - y);
      for (const k of keys.slice(i, j + 1)) on ? selected.add(k) : selected.delete(k);
    } else on ? selected.add(key) : selected.delete(key);
    lastTicked = key;
    updateSelection();
  }

  // one listener for every form inside the editor
  $("#editor").addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const f = Object.fromEntries(new FormData(form)) as Record<string, string>;
    try {
      if (form.id === "album-form") {
        await post("galeria/album/save", { slug: current, title: f.title, description: f.description, date: f.date, cover: f.cover, draft: f.draft === "on", body: f.body });
      } else {
        const key = form.dataset.key!;
        await post("galeria/picture/save", { key, title: f.title, description: f.description, kind: f.kind, date: f.date, alt: f.alt, draft: f.draft === "on" });
        const name = slugify(f.rename ?? "");
        if (name && name !== idOf(key.split("/").pop()!)) {
          const out = await post("galeria/picture/rename", { key, name });
          selected.delete(key);
          say(`salvo · arquivo renomeado para ${out.key.split("/").pop()}`); await load(); return;
        }
      }
      say("salvo"); await load();
    } catch (err: any) { say(err.message, true); }
  });

  $("#editor").addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const pic = t.closest<HTMLElement>(".pic");
    try {
      // selecting: the checkbox, or a click on the picture itself
      if (pic && (t.matches("[data-tick]") || t.tagName === "IMG")) {
        const key = pic.dataset.key!;
        tick(key, t.matches("[data-tick]") ? (t as HTMLInputElement).checked : !selected.has(key), (e as MouseEvent).shiftKey);
        return;
      }
      if (t.dataset.pin && pic) {
        await post("galeria/pictures/pin", { keys: [pic.dataset.key], pinned: t.dataset.pin === "1" });
        say(t.dataset.pin === "1" ? "fixada no topo" : "desafixada"); await load();
        return;
      }
      if (t.dataset.goto) { select(t.dataset.goto); renderAlbums(); renderEditor(); return; }
      if (t.id === "new-sub") return await createAlbum(current!);
      if (t.id === "move-album") {
        const form = $<HTMLFormElement>("#album-form");
        const name = slugify((form.elements.namedItem("name") as HTMLInputElement).value);
        const parent = (form.elements.namedItem("parent") as HTMLSelectElement).value;
        return await moveAlbum(current!, parent ? `${parent}/${name}` : name);
      }
      if (t.id === "delete-album") {
        const n = total(current!), subs = albumPaths().filter((s) => s.startsWith(current + "/")).length;
        if (!confirm(`Apagar o álbum "${current}"? Sai do site com ${n} imagem(ns)${subs ? ` e ${subs} sub-álbum(ns)` : ""}, e o texto do álbum é apagado. Os originais em galeria-entrada/ continuam lá.`)) return;
        await post("galeria/album/delete", { slug: current });
        select(parentOf(current!) || null); say("álbum apagado"); await load();
        return;
      }
      if (t.dataset.cover) {
        const a = data.albums.find((x) => x.slug === current)!;
        await post("galeria/album/save", { slug: current, ...a.data, cover: t.dataset.cover, body: a.body });
        say("capa trocada"); await load();
        return;
      }
      switch (t.dataset.sel) {
        case "all": currentKeys().forEach((k) => selected.add(k)); updateSelection(); break;
        case "none": selected.clear(); updateSelection(); break;
        case "move": await movePictures([...selected], $<HTMLSelectElement>("#dest").value); break;
        case "delete": {
          if (!confirm(`Tirar ${selected.size} imagem(ns) do site? Os originais em galeria-entrada/ continuam lá.`)) return;
          const out = await post("galeria/pictures/delete", { keys: [...selected] });
          selected.clear(); say(`${out.removed} removida(s)`); await load();
          break;
        }
      }
    } catch (err: any) { say(err.message, true); }
  });

  // dragging a picture drags the whole selection when it is part of it
  $("#editor").addEventListener("dragstart", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".pic");
    if (!li) return;
    const key = li.dataset.key!;
    e.dataTransfer!.setData(PICS, JSON.stringify(selected.has(key) ? [...selected] : [key]));
    e.dataTransfer!.effectAllowed = "move";
  });

  restoreStatus();
  load().catch((err) => say(err.message, true));
</script>
